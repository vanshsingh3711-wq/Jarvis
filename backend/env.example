# OpenAI (LLM, Embeddings, STT/TTS fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Sarvam AI (Hinglish STT/TTS - highly recommended for this project)
SARVAM_API_KEY=your_sarvam_api_key_here

# Cohere (Reranker - optional, we will also provide a local cross-encoder fallback)
COHERE_API_KEY=your_cohere_api_key_here

# LangSmith (Tracing and Guardrail Evaluation - Optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT="voice-native-rag"
